<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="gripperdelta">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import gripperdelta urdf file -->
    <xacro:include filename="$(find robot_gripper_description)/urdf/gripper_delta_robot.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="gripperdelta.ros2_control.xacro" />


    <xacro:gripperdelta_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
