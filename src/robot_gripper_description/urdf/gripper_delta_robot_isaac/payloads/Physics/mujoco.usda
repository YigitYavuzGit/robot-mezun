            uniform double mjc:forceRange:min = -100
            custom rel mjc:target
            prepend rel mjc:target = </gripperdelta/Physics/wrist4>
        }

        def MjcActuator "wsg_50_base_joint_gripper_left_actuator"
        {
            uniform double[] mjc:biasPrm = [0, 0, -100, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform double mjc:forceRange:max = 100
            uniform double mjc:forceRange:min = -100
            uniform double[] mjc:gainPrm = [100, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:gainType = "fixed"
            custom rel mjc:target
            prepend rel mjc:target = </gripperdelta/Physics/wsg_50_base_joint_gripper_left>
        }

        def MjcActuator "wsg_50_base_joint_gripper_right_actuator"
        {
            uniform double[] mjc:biasPrm = [0, 0, -100, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform double mjc:forceRange:max = 100
            uniform double mjc:forceRange:min = -100
            uniform double[] mjc:gainPrm = [100, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:gainType = "fixed"
            custom rel mjc:target
            prepend rel mjc:target = </gripperdelta/Physics/wsg_50_base_joint_gripper_right>
        }

        over "wsg_50_base_joint_gripper_left" (
            delete apiSchemas = ["PhysicsDriveAPI:linear", "PhysicsJointStateAPI:linear"]
        )
        {
            custom float mjc:frictionloss = 100
        }

        over "wsg_50_base_joint_gripper_right" (
