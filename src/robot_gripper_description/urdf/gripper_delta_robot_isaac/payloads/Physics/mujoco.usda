over "gripperdelta"
{
    over "Physics"
    {
        def MjcActuator "shoulder_actuator"
        {
            uniform double mjc:forceRange:max = 100
            uniform double mjc:forceRange:min = -100
            custom rel mjc:target
            prepend rel mjc:target = </gripperdelta/Physics/shoulder>
        }

        def MjcActuator "elbow_actuator"
        {
            uniform double mjc:forceRange:max = 100
            uniform double mjc:forceRange:min = -100
            custom rel mjc:target
            prepend rel mjc:target = </gripperdelta/Physics/elbow>
        }

        def MjcActuator "wrist1_actuator"
        {
            uniform double mjc:forceRange:max = 100
            uniform double mjc:forceRange:min = -100
            custom rel mjc:target
            prepend rel mjc:target = </gripperdelta/Physics/wrist1>
        }

        def MjcActuator "wrist2_actuator"
        {
            uniform double mjc:forceRange:max = 100
            uniform double mjc:forceRange:min = -100
            custom rel mjc:target
            prepend rel mjc:target = </gripperdelta/Physics/wrist2>
        }

        def MjcActuator "wrist3_actuator"
        {
            uniform double mjc:forceRange:max = 9.512043952941895
            uniform double mjc:forceRange:min = -9.512043952941895
            custom rel mjc:target
            prepend rel mjc:target = </gripperdelta/Physics/wrist3>
        }

        def MjcActuator "wrist4_actuator"
        {
